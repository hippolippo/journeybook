# Deployment config — copy to docker/.env and adjust.
#   cp docker/.env.example docker/.env
#   docker compose --env-file docker/.env up -d --build
#
# The public hostname Caddy serves. For a real domain, Caddy provisions TLS
# automatically (requires ports 80 and 443 reachable and DNS pointing here).
DOMAIN=journeybook.example.com

# --- Off-box backups (scripts/backup-offsite.sh) -----------------------------
# Configure exactly ONE destination. rclone and/or rsync must be installed on
# the host running the script. See docs/DEPLOYMENT.md for scheduling.
# BACKUP_REMOTE=gdrive:journeybook-backups
# BACKUP_RSYNC_TARGET=backup@host:/srv/journeybook-backups
