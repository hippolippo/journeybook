# Journeybook web: serves the built SPA and reverse-proxies PocketBase.
#
# The site address is the DOMAIN env var (defaults to localhost, for which Caddy
# issues an internal certificate). For a public domain, set DOMAIN and Caddy
# provisions TLS automatically. For a bare LAN IP that has no DNS name, add a
# `tls internal` line inside the site block.
#
# The app is served under APP_BASE (e.g. /journeybook). Caddy strips that prefix
# before serving files and before proxying to PocketBase, so the same image works
# at the root or under any subpath without being rebuilt.
{$DOMAIN:localhost} {
	encode zstd gzip

	# Send the bare base path to the trailing-slash form so the SPA resolves
	# under its base (e.g. /journeybook -> /journeybook/).
	@bare path {$APP_BASE:/journeybook}
	redir @bare {$APP_BASE:/journeybook}/ 308

	handle_path {$APP_BASE:/journeybook}/* {
		# PocketBase API + realtime subscriptions.
		@pb path /api/* /_/*
		handle @pb {
			# Uploaded files and generated thumbs are immutable per filename.
			@files path /api/files/*
			header @files Cache-Control "private, max-age=31536000, immutable"
			reverse_proxy pb:8090
		}

		# Hashed build assets never change. A missing one is a real 404, not the SPA.
		@assets path /assets/*
		handle @assets {
			root * /srv
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# Static SPA with history-mode fallback.
		handle {
			root * /srv
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}
